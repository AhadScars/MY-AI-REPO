# SpaceXAI / xAI — server-side only. Never expose this to the browser.
XAI_API_KEY=

# Optional model override. Default: grok-4.6
XAI_MODEL=grok-4.6

# App
NEXT_PUBLIC_APP_NAME=Prepwise
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth — generate with: openssl rand -base64 48
AUTH_SECRET=

# SQLite
DATABASE_URL="file:./dev.db"

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
