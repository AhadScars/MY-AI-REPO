<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.digihub.arrowescape.game.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/hudLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Lv 1"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hudHearts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="❤️ ❤️ ❤️"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hudCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="🪙 0"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="⏸"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hudHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_chip"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/hint_play"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Overlays -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#9A080A14"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/overlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/level_complete"
                android:textColor="@color/text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlaySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="⭐ ⭐ ⭐"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/overlayReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_stat_pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="🪙 +25  ·  ✨ +20 XP"
                android:textColor="@color/gold"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_success"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/next_level"
                android:textColor="#042F1A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlaySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/home"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayTertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/retry"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
