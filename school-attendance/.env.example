# Copy this file to .env and fill in your Meta WhatsApp Cloud API values.
# File location: school-attendance/.env  (same folder as main.py)

# Turn WhatsApp sending ON (1) or OFF (0)
WHATSAPP_ENABLED=0

# From Meta Developer → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# API version (optional)
WHATSAPP_API_VERSION=v21.0

# Country code for 10-digit local numbers (India = 91)
WHATSAPP_DEFAULT_COUNTRY=91

# Use an approved message template for production (1=yes, 0=free text for testing)
WHATSAPP_USE_TEMPLATE=0
WHATSAPP_TEMPLATE_NAME=attendance_alert
WHATSAPP_TEMPLATE_LANG=en
