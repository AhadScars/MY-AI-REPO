</main>
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <div class="brand footer-brand">
        <span class="brand-name"><%= appName %></span>
      </div>
      <p class="muted">Movies, concerts and live sport across India. Instant e-tickets, seats held for 12 minutes, prices in ₹.</p>
    </div>
    <div>
      <h4>Browse</h4>
      <a href="/movies">Movies</a>
      <a href="/events">Events</a>
      <a href="/sports">Sports</a>
      <a href="/plays">Plays</a>
    </div>
    <div>
      <h4>Account</h4>
      <% if (user) { %>
        <a href="/account">My bookings</a>
        <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
        <% if (user.role === 'organizer' || user.role === 'admin') { %><a href="/manage">Organizer</a><% } %>
        <a href="/logout">Sign out</a>
      <% } else { %>
        <a href="/login">Sign in</a>
        <a href="/register">Create account</a>
      <% } %>
    </div>
    <div>
      <h4>Support</h4>
      <p class="muted">hello@showspot.com<br>GST billed on the convenience fee. Cancel before showtime from My bookings.</p>
    </div>
  </div>
  <div class="wrap footer-bar">© <%= new Date().getFullYear() %> <%= appName %> India · Kanpur, Mumbai, Delhi and 12 more cities · Demo titles for illustration.</div>
</footer>
<script src="/js/app.js"></script>
<% if (typeof extraJs !== 'undefined') { %><script src="<%= extraJs %>"></script><% } %>
</body>
</html>
