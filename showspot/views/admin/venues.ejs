<%- include('../partials/panel-shell-start', { area: 'admin', title: title }) %>
<h1>Venues</h1>
<form class="card stack-form" method="post" action="/admin/venues">
  <h3>Add venue</h3>
  <div class="form-row">
    <label>Name <input name="name" required></label>
    <label>City
      <select name="city_id" required>
        <% cities.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
      </select>
    </label>
    <label>Organizer
      <select name="organizer_id">
        <% organizers.forEach(function(o){ %><option value="<%= o.id %>"><%= o.name %></option><% }) %>
      </select>
    </label>
    <label>Address <input name="address"></label>
    <label>Amenities (comma) <input name="amenities" placeholder="Dolby, Parking"></label>
    <label>Screens <input type="number" name="screens" value="1" min="1"></label>
    <label>Rows <input type="number" name="row_count" value="10"></label>
    <label>Cols <input type="number" name="col_count" value="14"></label>
  </div>
  <button class="btn btn-accent" type="submit">Create</button>
</form>
<div class="table-wrap">
  <table>
    <thead><tr><th>Venue</th><th>City</th><th>Screens</th><th>Organizer</th><th></th></tr></thead>
    <tbody>
      <% venues.forEach(function(v){ %>
        <tr>
          <td>
            <form method="post" action="/admin/venues/<%= v.id %>" class="stack-form compact">
              <input name="name" value="<%= v.name %>">
              <input name="address" value="<%= v.address || '' %>">
          </td>
          <td>
            <select name="city_id">
              <% cities.forEach(function(c){ %><option value="<%= c.id %>" <%= c.id===v.city_id?'selected':'' %>><%= c.name %></option><% }) %>
            </select>
          </td>
          <td><%= v.screen_count %></td>
          <td>
            <select name="organizer_id">
              <% organizers.forEach(function(o){ %><option value="<%= o.id %>" <%= o.id===v.organizer_id?'selected':'' %>><%= o.name %></option><% }) %>
            </select>
            <input type="hidden" name="amenities" value="<%= (parseJson(v.amenities, []) || []).join(', ') %>">
            <input type="hidden" name="status" value="<%= v.status %>">
          </td>
          <td class="row-actions">
              <button class="btn btn-ghost" type="submit">Save</button>
            </form>
            <form method="post" action="/admin/venues/<%= v.id %>" onsubmit="return confirm('Delete venue?')">
              <button class="btn btn-ghost" name="action" value="delete">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/panel-shell-end') %>
