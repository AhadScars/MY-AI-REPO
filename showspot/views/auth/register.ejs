<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="wrap auth-page">
  <div class="card auth-card">
    <h1>Join ShowSpot</h1>
    <%- include('../partials/flash') %>
    <form method="post" action="/register">
      <label>Name <input type="text" name="name" required autocomplete="name"></label>
      <label>Email <input type="email" name="email" required autocomplete="email"></label>
      <label>Phone <input type="tel" name="phone" autocomplete="tel"></label>
      <label>Password <input type="password" name="password" required minlength="6" autocomplete="new-password"></label>
      <button class="btn btn-accent btn-block" type="submit">Create account</button>
    </form>
    <p class="muted">Already have a seat? <a href="/login">Sign in</a></p>
  </div>
</section>
<%- include('../partials/footer') %>
