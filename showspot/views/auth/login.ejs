<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="wrap auth-page">
  <div class="card auth-card">
    <h1>Sign in</h1>
    <%- include('../partials/flash') %>
    <form method="post" action="/login">
      <input type="hidden" name="next" value="<%= next %>">
      <label>Email <input type="email" name="email" required autocomplete="email"></label>
      <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
      <button class="btn btn-accent btn-block" type="submit">Enter</button>
    </form>
    <p class="muted">New here? <a href="/register">Create an account</a></p>
    <div class="demo-creds">
      <p>Demo logins</p>
      <code>admin@showspot.com / Admin@123</code>
      <code>organizer@showspot.com / Organizer@123 · Aetherplex Kanpur</code>
      <code>user@showspot.com / User@123</code>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
