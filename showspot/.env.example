# Copy to .env and fill in. On Hostinger, set these in the Node.js Web App
# environment variables panel (or as a .env next to server.js).

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=ShowSpot
JWT_SECRET=change-this-to-a-long-random-string

# sqlite (default, no server) or mysql (Hostinger later)
DB_CLIENT=sqlite
DB_FILE=data/showspot.sqlite

# Used only when DB_CLIENT=mysql
# Hostinger: same-server Node app host is usually localhost
DB_HOST=localhost
DB_PORT=3306
DB_USER=showspot
DB_PASSWORD=showspot
DB_NAME=showspot
DB_SSL=false

# Stripe (https://dashboard.stripe.com/apikeys)
# Leave blank to use Demo Pay so you can test bookings without Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Display currency for Stripe Checkout. Use a Stripe-supported code (usd, pkr, inr, aed, gbp).
CURRENCY=inr
CURRENCY_SYMBOL=₹

# Booking
HOLD_MINUTES=12
CONVENIENCE_FEE_PERCENT=5
TAX_PERCENT=18
MAX_SEATS_PER_BOOKING=10
