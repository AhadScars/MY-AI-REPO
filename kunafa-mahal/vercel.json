{
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "api/[...path].py", "use": "@vercel/python", "config": { "maxLambdaSize": "50mb", "includeFiles": "{data/**,emails.py,server.py}" } },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].py" },
    { "src": "/auth/google", "dest": "/api/[...path].py" },
    { "src": "/auth/google/callback", "dest": "/api/[...path].py" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" }
  ]
}
