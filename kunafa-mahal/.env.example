# Google Gmail SMTP
# Copy this file to .env and fill in your values, then restart the server.
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Kunafa Mahal <your-gmail@gmail.com>
SMTP_TO=your-gmail@gmail.com
SITE_URL=http://localhost:4173
# On Vercel set SITE_URL to https://your-app.vercel.app
# and GOOGLE_REDIRECT_URI to https://your-app.vercel.app/auth/google/callback

# Google OAuth (Sign in with Google + optional Gmail send)
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Redirect URI: http://localhost:4173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/auth/google/callback
